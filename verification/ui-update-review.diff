+    onSearch: (String, SearchProvider) -> Unit,
+    onCancelSearch: () -> Unit,
+) {
+    var destination by rememberSaveable { mutableIntStateOf(0) }
+    var fullPlayer by rememberSaveable { mutableStateOf(false) }
